class Counter {
    def __init__() { this.value = 0 }
    def bump() { this.value = this.value + 1 }
}

def run(n) {
    val counter = Counter()
    for i in range(n) {
        counter.bump()
    }
    counter.value
}

run(1000)
val start = clock()
var reps = 0
var result = 0
while reps < 100000 {
    result = run(5000)
    reps = reps + 1
    if (clock() - start) * 1000.0 >= 100.0: break
}
print(result)
print((clock() - start) * 1000.0 / reps)
